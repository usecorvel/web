{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "vite",
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"cleanUrls": true,
	"rewrites": [
		{
			"source": "/:path(pricing|how-it-works|for-clinics|for-salons|for-physical-therapy|for-chiropractors|for-barbershops|integrations|about|contact)",
			"destination": "/"
		}
	]
}
